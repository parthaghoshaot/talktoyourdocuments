# LLM Provider: openai | gemini | ollama
LLM_PROVIDER=openai

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://yourendpoint.net


# OpenAI 
OPENAI_MODEL=gpt-5.1

# Google Gemini 
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Paths (optional, defaults to project directory)
# DOCUMENTS_DIR=/path/to/your/documents
# DB_PATH=/path/to/knowledge.db
# LLM_API_VERSION=2024-10-21
